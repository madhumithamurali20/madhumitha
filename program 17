
# Medical Expert System

print("MEDICAL EXPERT SYSTEM")
print("---------------------")

# Get patient symptoms
fever = input("Do you have fever? (yes/no): ").lower()
cough = input("Do you have cough? (yes/no): ").lower()
headache = input("Do you have headache? (yes/no): ").lower()
sneezing = input("Do you have sneezing? (yes/no): ").lower()
body_pain = input("Do you have body pain? (yes/no): ").lower()

print("\n--- DIAGNOSIS RESULT ---")

# Rule-based reasoning
if fever == "yes" and cough == "yes" and body_pain == "yes":
    print("Possible condition: Flu-like illness")

elif sneezing == "yes" and cough == "yes" and fever == "no":
    print("Possible condition: Common cold")

elif fever == "yes" and headache == "yes":
    print("Possible condition: Fever-related illness")

elif headache == "yes" and body_pain == "yes":
    print("Possible condition: General viral illness")

else:
    print("No matching rule found.")
    print("Please consult a healthcare professional.")

print("\nThank you!")
print("This is only an educational expert system.")

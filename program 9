from collections import deque
def water_jug(capacity1, capacity2, target):
    visited = set()
    queue = deque([((0, 0), [])])
    while queue:
        (a, b), path = queue.popleft()
        if (a, b) in visited:
            continue
        visited.add((a, b))
        path = path + [(a, b)]
        if a == target or b == target:
            print("Solution found:")
            for state in path:
                print(state)
            return
        next_states = [
            (capacity1, b),       
            (a, capacity2),       
            (0, b),               
            (a, 0),               
            (a - min(a, capacity2-b),
             b + min(a, capacity2-b)),  
            (a + min(b, capacity1-a),
             b - min(b, capacity1-a))   
        ]
        for state in next_states:
            if state not in visited:
                queue.append((state, path))
    print("No solution possible")
jug1 = 4
jug2 = 3
target = 2
water_jug(jug1, jug2, target)







import heapq
def best_first_search(graph, heuristic, start, goal):
    priority_queue = [(heuristic[start], start)]
    visited = set()
    path = []
    while priority_queue:
        h, city = heapq.heappop(priority_queue)
        if city in visited:
            continue
        visited.add(city)
        path.append(city)
        if city == goal:
            print("Path Found:", " -> ".join(path))
            return
        for neighbour in graph[city]:
            if neighbour not in visited:
                heapq.heappush(
                    priority_queue,
                    (heuristic[neighbour], neighbour)
                )
    print("Path not found!")
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': ['G'],
    'E': ['G'],
    'F': ['G'],
    'G': []
}
heuristic = {
    'A': 10,
    'B': 8,
    'C': 5,
    'D': 6,
    'E': 3,
    'F': 2,
    'G': 0
}
start = 'A'
goal = 'G'
print("Best First Search Algorithm")
best_first_search(graph, heuristic, start, goal)

